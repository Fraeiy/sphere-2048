# Supabase (service role — worker needs to write payouts / settle rounds)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Treasury Sphere wallet (same identity that receives deposits, e.g. @2048game)
# Prefer mnemonic. Do NOT commit real secrets.
TREASURY_MNEMONIC="word1 word2 ... word12"
# Optional password if wallet.json is encrypted
# TREASURY_PASSWORD=
TREASURY_NAMETAG=2048game

# Local Sphere data dirs (persist across runs so open intents resume safely)
TREASURY_DATA_DIR=./data/wallet
TREASURY_TOKENS_DIR=./data/tokens
TREASURY_DEVICE_ID=sphere-2048-treasury-worker

# Unicity network (testnet2)
SPHERE_NETWORK=testnet2
# Public testnet2 gateway key (not a secret)
SPHERE_ORACLE_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590
SPHERE_WALLET_API_URL=https://wallet-api.unicity.network

# UCT coin id hex (optional override; default is shared UCT_TESTNET2_COIN_ID)
# UCT_COIN_ID=f581d30f593e4b369d684a4563b5246f07b1d265f7178a2c0a82b81f39c24dc0

# Payout safety
MAX_PAY_ATTEMPTS=5
# Dry-run: settle + log payouts, never send UCT or DMs
# DRY_RUN=true
